{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/mcp/(.*)",
      "destination": "/api/mcp?__path=$1"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/((?!api/|mcp|assets/|favicon\\.png|icon-.*\\.png|manifest\\.json|sw\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
